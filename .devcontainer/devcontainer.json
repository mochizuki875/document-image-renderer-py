{
  "name": "document-image-renderer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "mounts": [
    "source=/etc/hosts,target=/etc/hosts,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}